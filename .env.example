# IA — pegue uma chave grátis em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opcional: aumenta rate limit do GitHub de 60/h para 5000/h.
# Gere em https://github.com/settings/tokens com acesso mínimo a repositórios públicos.
GITHUB_TOKEN=

# Opcional: Redis/Upstash para cache persistente e share links (/r/<id>).
# Use as variáveis do Vercel KV...
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ...ou as variáveis padrão do Upstash direto.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
